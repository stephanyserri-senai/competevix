# Copie para .env.local e preencha. NUNCA versione valores reais.
# Painel do Supabase → Project Settings → API

# Públicas (vão ao navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor (convites, desativação de login, rotina de alertas). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Segredo da rota /api/cron/alertas (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Testes de banco/RLS (PostgreSQL local com os shims de supabase/tests/shims)
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/competevix_test?host=/tmp
